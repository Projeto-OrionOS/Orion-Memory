static void format_percent(double value,wchar_t *out,int cap){swprintf(out,(size_t)cap,L"%.3f%%",isfinite(value)?value:0.0);for(wchar_t *p=out;*p;++p)if(*p==L'.')*p=L',';}
static void format_bytes(uint64_t bytes,wchar_t *out,int cap){if(bytes>=1073741824ULL)swprintf(out,(size_t)cap,L"%.2f GB",bytes/1073741824.0);else swprintf(out,(size_t)cap,L"%.0f MB",bytes/1048576.0);for(wchar_t *p=out;*p;++p)if(*p==L'.')*p=L',';}
static void main_fonts(HWND hwnd){if(g_main_font)DeleteObject(g_main_font);if(g_main_heading)DeleteObject(g_main_heading);if(g_main_value_font)DeleteObject(g_main_value_font);g_main_font=ui_font(hwnd,12,FW_NORMAL);g_main_heading=ui_font(hwnd,13,FW_SEMIBOLD);g_main_value_font=ui_font(hwnd,13,FW_NORMAL);g_main_values_valid=0;memset(g_main_value_width,0,sizeof(g_main_value_width));for(int i=0;i<5;++i)if(g_main_buttons[i])SendMessageW(g_main_buttons[i],WM_SETFONT,(WPARAM)(i==4?g_main_heading:g_main_font),FALSE);}
static RECT main_card_rect(HWND hwnd,int group){RECT client;GetClientRect(hwnd,&client);int margin=ui_scale(hwnd,12),gap=ui_scale(hwnd,8),top=ui_scale(hwnd,43),bottom=ui_scale(hwnd,60),graph=g_settings.show_graph?ui_scale(hwnd,66):0,height=(client.bottom-top-bottom-graph-gap*2)/3;int maximum=ui_scale(hwnd,108);if(height>maximum)height=maximum;RECT card={margin,top+group*(height+gap),client.right-margin,top+group*(height+gap)+height};return card;}
static RECT main_value_rect(HWND hwnd,int index,int measured_width){RECT card=main_card_rect(hwnd,index/3);RECT r=card;r.right-=ui_scale(hwnd,13);r.left=r.right-max(ui_scale(hwnd,114),measured_width+ui_scale(hwnd,4));if(r.left<card.left+ui_scale(hwnd,12))r.left=card.left+ui_scale(hwnd,12);r.top+=ui_scale(hwnd,34+(index%3)*20);r.bottom=r.top+ui_scale(hwnd,19);return r;}
static RECT main_graph_rect(HWND hwnd){RECT client,card=main_card_rect(hwnd,2);GetClientRect(hwnd,&client);RECT r={ui_scale(hwnd,12),card.bottom+ui_scale(hwnd,8),client.right-ui_scale(hwnd,12),client.bottom-ui_scale(hwnd,56)};return r;}
static void main_format_values(wchar_t values[9][128]){format_percent(g_memory.physical_percent,values[0],128);format_bytes(g_memory.available,values[1],128);format_bytes(g_memory.total,values[2],128);format_percent(g_memory.commit_percent,values[3],128);format_bytes(g_memory.commit_limit>g_memory.commit_used?g_memory.commit_limit-g_memory.commit_used:0,values[4],128);format_bytes(g_memory.commit_limit,values[5],128);format_bytes(g_memory.cache,values[6],128);format_percent(g_memory.cache_percent,values[7],128);swprintf(values[8],128,L"%lu",g_memory.processes);}
static BOOL CALLBACK main_find_owned(HWND window,LPARAM data){if(GetWindow(window,GW_OWNER)!=g_main_hwnd)return TRUE;wchar_t name[128];if(!GetClassNameW(window,name,128))return TRUE;/* Input-method helper windows can outlive their last edit control. */if(!wcsncmp(name,L"OrionMemory.",12)||(!wcscmp(name,L"#32770")&&IsWindowVisible(window))){*(int*)data=1;return FALSE;}return TRUE;}
static int main_has_owned_windows(void){int owned=0;EnumThreadWindows(GetCurrentThreadId(),main_find_owned,(LPARAM)&owned);return owned;}
static void main_remember_placement(void){memset(&g_main_saved_placement,0,sizeof(g_main_saved_placement));g_main_saved_placement.length=sizeof(g_main_saved_placement);g_main_saved_placement_valid=GetWindowPlacement(g_main_hwnd,&g_main_saved_placement)!=0;g_main_saved_placement.showCmd=SW_SHOWNORMAL;g_main_saved_graph=g_settings.show_graph;g_main_saved_dpi=GetDpiForWindow(g_main_hwnd);if(!g_main_saved_dpi)g_main_saved_dpi=96;}
static void main_hide_or_release(void){if(!g_main_hwnd)return;main_remember_placement();if(g_busy||native_authorization_busy()||main_has_owned_windows())ShowWindow(g_main_hwnd,SW_HIDE);else DestroyWindow(g_main_hwnd);}
/* Called after a memory sample. Only changed values invalidate their own strip;
   labels, card outlines and native child buttons keep their existing pixels. */
static void native_main_sample_changed(void){if(!g_main_hwnd)return;if(!g_main_constructing&&!g_busy&&!native_authorization_busy()&&!IsWindowVisible(g_main_hwnd)&&!main_has_owned_windows()){main_remember_placement();DestroyWindow(g_main_hwnd);return;}wchar_t next[9][128];main_format_values(next);int visible=IsWindowVisible(g_main_hwnd);HDC dc=NULL;HGDIOBJ previous=NULL;for(int i=0;i<9;++i){if(g_main_values_valid&&!wcscmp(next[i],g_main_values[i]))continue;RECT before=main_value_rect(g_main_hwnd,i,g_main_value_width[i]);if(!dc){dc=GetDC(g_main_hwnd);previous=SelectObject(dc,g_main_value_font);}SIZE ink={0};GetTextExtentPoint32W(dc,next[i],(int)wcslen(next[i]),&ink);g_main_value_width[i]=ink.cx;copyw(g_main_values[i],128,next[i]);if(visible){RECT after=main_value_rect(g_main_hwnd,i,ink.cx),dirty;UnionRect(&dirty,&before,&after);InvalidateRect(g_main_hwnd,&dirty,FALSE);}}if(dc){SelectObject(dc,previous);ReleaseDC(g_main_hwnd,dc);}g_main_values_valid=1;if(visible&&g_settings.show_graph){RECT graph=main_graph_rect(g_main_hwnd);InvalidateRect(g_main_hwnd,&graph,FALSE);}}
static void main_layout(HWND hwnd){RECT client;GetClientRect(hwnd,&client);int margin=ui_scale(hwnd,12),width=client.right,menu_widths[]={61,53,103,53},x=margin;HDWP placement=BeginDeferWindowPos(5);for(int i=0;i<4;++i){int w=ui_scale(hwnd,menu_widths[i]);placement=DeferWindowPos(placement,g_main_buttons[i],NULL,x,ui_scale(hwnd,5),w,ui_scale(hwnd,30),SWP_NOZORDER|SWP_NOACTIVATE);x+=w+ui_scale(hwnd,3);}placement=DeferWindowPos(placement,g_main_buttons[4],NULL,margin,client.bottom-margin-ui_scale(hwnd,36),width-2*margin,ui_scale(hwnd,36),SWP_NOZORDER|SWP_NOACTIVATE);if(placement)EndDeferWindowPos(placement);g_main_client_height=client.bottom;}
/* Configuration/availability refresh, not a periodic repaint. */
static void native_main_refresh(void){if(!g_main_hwnd)return;int full_repaint=0;if(g_main_graph_visible!=g_settings.show_graph){int change=ui_scale(g_main_hwnd,66)*(g_settings.show_graph?1:-1);g_main_graph_visible=g_settings.show_graph;if(IsIconic(g_main_hwnd)){WINDOWPLACEMENT p;memset(&p,0,sizeof(p));p.length=sizeof(p);if(GetWindowPlacement(g_main_hwnd,&p)){p.rcNormalPosition.bottom+=change;SetWindowPlacement(g_main_hwnd,&p);}}else{RECT r;GetWindowRect(g_main_hwnd,&r);SetWindowPos(g_main_hwnd,NULL,0,0,r.right-r.left,r.bottom-r.top+change,SWP_NOMOVE|SWP_NOZORDER|SWP_NOACTIVATE);}full_repaint=1;}
    if(g_main_visual_dark!=g_settings.dark||g_main_visual_blur!=g_settings.window_blur){
        g_main_visual_dark=g_settings.dark;
        g_main_visual_blur=g_settings.window_blur;
        ui_apply_window(g_main_hwnd);
        full_repaint=1;
    }
    if(g_main_topmost!=g_settings.always_on_top){g_main_topmost=g_settings.always_on_top;SetWindowPos(g_main_hwnd,g_main_topmost?HWND_TOPMOST:HWND_NOTOPMOST,0,0,0,0,SWP_NOMOVE|SWP_NOSIZE|SWP_NOACTIVATE);}
    if(wcscmp(g_main_language,g_settings.language)||!g_main_button_labels[0][0]){copyw(g_main_language,32,g_settings.language);for(int i=0;i<5;++i){wchar_t text[128];translate(main_button_sources[i],text,128);if(wcscmp(g_main_button_labels[i],text)){copyw(g_main_button_labels[i],128,text);SetWindowTextW(g_main_buttons[i],text);}}for(int i=0;i<3;++i)translate(main_title_sources[i],g_main_titles[i],160);for(int i=0;i<9;++i)translate(main_label_sources[i],g_main_labels[i],160);full_repaint=1;}
    int enabled=!g_busy&&!native_authorization_busy();if(g_main_enabled!=enabled){g_main_enabled=enabled;EnableWindow(g_main_buttons[4],enabled);}
    COLORREF accent=ui_accent();if(!g_main_graph_pen||accent!=g_main_graph_color){if(g_main_graph_pen)DeleteObject(g_main_graph_pen);g_main_graph_pen=CreatePen(PS_SOLID,max(1,ui_scale(g_main_hwnd,2)),accent);g_main_graph_color=accent;}
    native_main_sample_changed();if(full_repaint&&g_main_hwnd)RedrawWindow(g_main_hwnd,NULL,NULL,RDW_INVALIDATE|RDW_ALLCHILDREN);
}
static int main_intersects(RECT a,RECT b){RECT intersection;return IntersectRect(&intersection,&a,&b);}
static void main_row(HWND hwnd,HDC dc,RECT card,int index,RECT clip){RECT value=main_value_rect(hwnd,index,g_main_value_width[index]),label=value;label.left=card.left+ui_scale(hwnd,13);label.right=value.left-ui_scale(hwnd,8);if(main_intersects(label,clip))ui_text_draw(dc,label,g_main_labels[index],g_main_font,ui_muted(),DT_LEFT|DT_SINGLELINE|DT_VCENTER|DT_END_ELLIPSIS);if(main_intersects(value,clip))ui_text_draw(dc,value,g_main_values[index],g_main_value_font,index==0?ui_accent():ui_text(),DT_RIGHT|DT_SINGLELINE|DT_VCENTER);}
static void main_paint(HWND hwnd,HDC dc){RECT client,clip;GetClientRect(hwnd,&client);int clipping=GetClipBox(dc,&clip);if(clipping==ERROR||clipping==NULLREGION)return;ui_fill(dc,clip,ui_background());for(int group=0;group<3;++group){RECT card=main_card_rect(hwnd,group);if(!main_intersects(card,clip))continue;ui_round_border(dc,card,ui_surface(),ui_outline(),ui_scale(hwnd,8));RECT title=card;title.left+=ui_scale(hwnd,13);title.top+=ui_scale(hwnd,8);title.right-=ui_scale(hwnd,13);title.bottom=title.top+ui_scale(hwnd,21);if(main_intersects(title,clip))ui_text_draw(dc,title,g_main_titles[group],g_main_heading,ui_text(),DT_LEFT|DT_SINGLELINE|DT_VCENTER|DT_END_ELLIPSIS);for(int row=0;row<3;++row)main_row(hwnd,dc,card,group*3+row,clip);}
    if(g_settings.show_graph){RECT graph=main_graph_rect(hwnd);if(main_intersects(graph,clip)){ui_round_border(dc,graph,ui_surface(),ui_outline(),ui_scale(hwnd,8));if(g_graph_count>1&&g_main_graph_pen){HGDIOBJ old=SelectObject(dc,g_main_graph_pen);int w=graph.right-graph.left-ui_scale(hwnd,16),h=graph.bottom-graph.top-ui_scale(hwnd,12);for(int i=0;i<g_graph_count;++i){int x=graph.left+ui_scale(hwnd,8)+MulDiv(i,w,g_graph_count-1),y=graph.bottom-ui_scale(hwnd,6)-(int)(h*g_graph_values[i]/100.0);if(!i)MoveToEx(dc,x,y,NULL);else LineTo(dc,x,y);}SelectObject(dc,old);}}}
}
static void main_draw_toolbar(DRAWITEMSTRUCT *item){RECT r=item->rcItem;ui_fill(item->hDC,r,ui_background());int hot=GetPropW(item->hwndItem,L"Orion.Hover")!=NULL,focus=(item->itemState&ODS_FOCUS)&&!(item->itemState&ODS_NOFOCUSRECT);if(hot||(item->itemState&ODS_SELECTED)||focus){RECT inner=r;InflateRect(&inner,-ui_scale(item->hwndItem,1),-ui_scale(item->hwndItem,1));if(focus)ui_round_border(item->hDC,inner,ui_surface(),ui_accent(),ui_scale(item->hwndItem,6));else ui_round(item->hDC,inner,ui_surface(),ui_scale(item->hwndItem,6));}int index=(int)item->CtlID-MAIN_FILE;if(index>=0&&index<4)ui_text_draw(item->hDC,r,g_main_button_labels[index],g_main_font,ui_text(),DT_CENTER|DT_VCENTER|DT_SINGLELINE);}
static LRESULT CALLBACK native_main_proc(HWND hwnd,UINT message,WPARAM wp,LPARAM lp){switch(message){case WM_CREATE:{g_main_hwnd=hwnd;g_main_graph_visible=g_settings.show_graph;g_main_visual_dark=g_main_visual_blur=g_main_topmost=g_main_enabled=-1;g_main_language[0]=0;memset(g_main_button_labels,0,sizeof(g_main_button_labels));main_fonts(hwnd);for(int i=0;i<5;++i){wchar_t label[128];translate(main_button_sources[i],label,128);g_main_buttons[i]=CreateWindowExW(0,L"BUTTON",label,WS_CHILD|WS_VISIBLE|WS_TABSTOP|BS_OWNERDRAW,0,0,10,10,hwnd,(HMENU)(INT_PTR)(MAIN_FILE+i),g_instance,NULL);SendMessageW(g_main_buttons[i],WM_SETFONT,(WPARAM)(i==4?g_main_heading:g_main_font),FALSE);ui_prepare_button(g_main_buttons[i]);}main_layout(hwnd);native_main_refresh();return 0;}
    case WM_SIZE:if(wp==SIZE_MINIMIZED&&g_settings.close_to_tray){main_hide_or_release();return 0;}main_layout(hwnd);InvalidateRect(hwnd,NULL,FALSE);return 0;
    case WM_GETMINMAXINFO:{MINMAXINFO *limits=(MINMAXINFO*)lp;limits->ptMinTrackSize.x=ui_scale(hwnd,356);limits->ptMinTrackSize.y=ui_scale(hwnd,g_settings.show_graph?522:456);return 0;}
    case WM_DPICHANGED:{RECT *r=(RECT*)lp;SetWindowPos(hwnd,NULL,r->left,r->top,r->right-r->left,r->bottom-r->top,SWP_NOZORDER|SWP_NOACTIVATE);main_fonts(hwnd);if(g_main_graph_pen){DeleteObject(g_main_graph_pen);g_main_graph_pen=NULL;}main_layout(hwnd);native_main_refresh();InvalidateRect(hwnd,NULL,FALSE);return 0;}
    case WM_SETTINGCHANGE:case WM_THEMECHANGED:g_main_visual_dark=g_main_visual_blur=-1;native_main_refresh();return 0;
    case WM_COMMAND:{if(lp&&HIWORD(wp)!=BN_CLICKED)return 0;int command=LOWORD(wp);if(command==MAIN_SETTINGS)native_settings_show(hwnd);else if(command==MAIN_CLEAN)native_request_cleanup(hwnd);else if(command==MAIN_FILE||command==MAIN_VIEW||command==MAIN_HELP){RECT button;GetWindowRect(g_main_buttons[command-MAIN_FILE],&button);POINT point={button.left,button.bottom+ui_scale(hwnd,4)};native_popup_open(hwnd,command==MAIN_FILE?1:command==MAIN_VIEW?2:3,point);}return 0;}
    case WM_DRAWITEM:{DRAWITEMSTRUCT *item=(DRAWITEMSTRUCT*)lp;if(item->CtlType==ODT_BUTTON){if(item->CtlID==MAIN_CLEAN)ui_draw_button_ex(item,1);else main_draw_toolbar(item);return TRUE;}return 0;}
    case WM_PRINTCLIENT:main_paint(hwnd,(HDC)wp);return 0;
    case WM_ERASEBKGND:return 1;
    case WM_PAINT:{PAINTSTRUCT paint;HDC dc=BeginPaint(hwnd,&paint);ui_paint_buffered(hwnd,dc,&paint.rcPaint,main_paint);EndPaint(hwnd,&paint);return 0;}
    case WM_CLOSE:if(g_settings.close_to_tray){main_hide_or_release();return 0;}PostMessageW(g_hwnd,WM_CLOSE,0,0);return 0;
    case WM_DESTROY:if(g_main_font)DeleteObject(g_main_font);if(g_main_heading)DeleteObject(g_main_heading);if(g_main_value_font)DeleteObject(g_main_value_font);if(g_main_graph_pen)DeleteObject(g_main_graph_pen);g_main_font=g_main_heading=g_main_value_font=NULL;g_main_graph_pen=NULL;memset(g_main_buttons,0,sizeof(g_main_buttons));g_main_values_valid=0;g_main_hwnd=NULL;return 0;
}return DefWindowProcW(hwnd,message,wp,lp);}
static void native_main_show(void){g_main_constructing=1;if(!g_main_hwnd){WNDCLASSEXW cls;memset(&cls,0,sizeof(cls));cls.cbSize=sizeof(cls);cls.lpfnWndProc=native_main_proc;cls.hInstance=g_instance;cls.hCursor=LoadCursorW(NULL,IDC_ARROW);cls.hIcon=LoadIconW(g_instance,MAKEINTRESOURCEW(1));cls.hIconSm=cls.hIcon;cls.lpszClassName=MAIN_CLASS;RegisterClassExW(&cls);DWORD style=WS_OVERLAPPED|WS_CAPTION|WS_SYSMENU|WS_MINIMIZEBOX|WS_THICKFRAME|WS_CLIPCHILDREN;RECT area={0,0,MulDiv(368,(int)g_dpi,96),MulDiv(g_settings.show_graph?498:432,(int)g_dpi,96)};AdjustWindowRectExForDpi(&area,style,FALSE,0,g_dpi);HWND window=CreateWindowExW(0,MAIN_CLASS,L"Orion Memory",style,CW_USEDEFAULT,CW_USEDEFAULT,area.right-area.left,area.bottom-area.top,NULL,NULL,g_instance,NULL);if(!window){g_main_constructing=0;return;}if(g_main_saved_placement_valid){WINDOWPLACEMENT saved=g_main_saved_placement;if(g_main_saved_graph!=g_settings.show_graph)saved.rcNormalPosition.bottom+=MulDiv(66*(g_settings.show_graph?1:-1),(int)g_main_saved_dpi,96);SetWindowPlacement(window,&saved);}else ui_center(window,NULL);}update_memory();native_main_refresh();ShowWindow(g_main_hwnd,SW_RESTORE);g_main_constructing=0;InvalidateRect(g_main_hwnd,NULL,FALSE);SetForegroundWindow(g_main_hwnd);SetFocus(g_main_buttons[4]);}
static void native_main_toggle(void){if(g_main_hwnd&&IsWindowVisible(g_main_hwnd))main_hide_or_release();else native_main_show();}
static int native_main_message(MSG *message){if(!g_main_hwnd||!IsWindowVisible(g_main_hwnd))return 0;if(message->message==WM_SYSKEYDOWN){int command=0;switch(message->wParam){case 'F':case 'A':command=MAIN_FILE;break;case 'V':case 'E':command=MAIN_VIEW;break;case 'S':case 'C':command=MAIN_SETTINGS;break;case 'H':case 'J':command=MAIN_HELP;break;}if(command){SendMessageW(g_main_hwnd,WM_COMMAND,command,0);return 1;}}return IsDialogMessageW(g_main_hwnd,message);}

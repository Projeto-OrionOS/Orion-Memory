/* Reuse only a previously authorized, fixed Task Scheduler action.  This never
   creates tasks, disables UAC, modifies ACLs or requests an elevation prompt. */
static int process_elevated(void){HANDLE token;TOKEN_ELEVATION elevation;DWORD bytes;if(!OpenProcessToken(GetCurrentProcess(),TOKEN_QUERY,&token))return 0;int ok=GetTokenInformation(token,TokenElevation,&elevation,sizeof(elevation),&bytes);CloseHandle(token);return ok&&elevation.TokenIsElevated;}
static int current_sid(wchar_t *out,int cap){HANDLE token;DWORD bytes=0;if(!OpenProcessToken(GetCurrentProcess(),TOKEN_QUERY,&token))return 0;GetTokenInformation(token,TokenUser,NULL,0,&bytes);TOKEN_USER *user=(TOKEN_USER*)malloc(bytes);int ok=user&&GetTokenInformation(token,TokenUser,user,bytes,&bytes);LPWSTR sid=NULL;if(ok)ok=ConvertSidToStringSidW(user->User.Sid,&sid);if(ok){ok=wcslen(sid)<(size_t)cap;if(ok)copyw(out,(size_t)cap,sid);}LocalFree(sid);free(user);CloseHandle(token);return ok;}
static int product_version(const wchar_t *path,DWORD *high,DWORD *low){DWORD unused,size=GetFileVersionInfoSizeW(path,&unused);if(!size||size>1024*1024)return 0;void *buffer=malloc(size);VS_FIXEDFILEINFO *info=NULL;UINT info_size=0;int ok=buffer&&GetFileVersionInfoW(path,0,size,buffer)&&VerQueryValueW(buffer,L"\\",(LPVOID*)&info,&info_size)&&info_size>=sizeof(*info)&&info->dwSignature==0xFEEF04BD;if(ok){*high=info->dwProductVersionMS;*low=info->dwProductVersionLS;}free(buffer);return ok;}
static int same_product(const wchar_t *left,const wchar_t *right){DWORD lh,ll,rh,rl;return product_version(left,&lh,&ll)&&product_version(right,&rh,&rl)&&lh==rh&&ll==rl;}
static int real_path(const wchar_t *path,int directory){DWORD attr=GetFileAttributesW(path);return attr!=INVALID_FILE_ATTRIBUTES&&!(attr&FILE_ATTRIBUTE_REPARSE_POINT)&&((attr&FILE_ATTRIBUTE_DIRECTORY)!=0)==directory;}
static int run_scheduler(const wchar_t *arguments,char **output){wchar_t executable[MAX_PATH],command[1024];UINT length=GetSystemDirectoryW(executable,MAX_PATH);if(!length||length+15>=MAX_PATH)return 0;wcscat(executable,L"\\schtasks.exe");swprintf(command,1024,L"\"%ls\" %ls",executable,arguments);SECURITY_ATTRIBUTES security={sizeof(security),NULL,TRUE};HANDLE reader=NULL,writer=NULL;if(!CreatePipe(&reader,&writer,&security,65536))return 0;SetHandleInformation(reader,HANDLE_FLAG_INHERIT,0);STARTUPINFOW startup;memset(&startup,0,sizeof(startup));startup.cb=sizeof(startup);startup.dwFlags=STARTF_USESTDHANDLES|STARTF_USESHOWWINDOW;startup.wShowWindow=SW_HIDE;startup.hStdOutput=writer;startup.hStdError=writer;startup.hStdInput=GetStdHandle(STD_INPUT_HANDLE);PROCESS_INFORMATION process;memset(&process,0,sizeof(process));int ok=CreateProcessW(executable,command,NULL,NULL,TRUE,CREATE_NO_WINDOW,NULL,NULL,&startup,&process);CloseHandle(writer);if(!ok){CloseHandle(reader);return 0;}char *captured=(char*)calloc(65538,1);DWORD total=0,started=GetTickCount();while(GetTickCount()-started<5000){DWORD available=0;if(PeekNamedPipe(reader,NULL,0,NULL,&available,NULL)&&available){DWORD read=0,room=65536-total;if(!room){ok=0;break;}if(ReadFile(reader,captured+total,min(room,available),&read,NULL))total+=read;}if(WaitForSingleObject(process.hProcess,20)==WAIT_OBJECT_0){DWORD pending=0;while(total<65536&&PeekNamedPipe(reader,NULL,0,NULL,&pending,NULL)&&pending){DWORD read=0;if(!ReadFile(reader,captured+total,min(65536-total,pending),&read,NULL)||!read)break;total+=read;}break;}}DWORD exit_code=STILL_ACTIVE;GetExitCodeProcess(process.hProcess,&exit_code);if(exit_code==STILL_ACTIVE){/* The process is our own read/run client, never the scheduled task or UI. */TerminateProcess(process.hProcess,1);WaitForSingleObject(process.hProcess,1000);ok=0;}else ok=ok&&exit_code==0;CloseHandle(process.hThread);CloseHandle(process.hProcess);CloseHandle(reader);if(output)*output=captured;else free(captured);return ok;}
static wchar_t *scheduler_xml(const char *raw){if(!raw)return NULL;size_t n=0;/* Query output is usually UTF-16LE and may contain embedded zero bytes. */while(n<65536&&(raw[n]||raw[n+1]))++n;if(n>=65536)return NULL;wchar_t *wide=(wchar_t*)calloc(32770,sizeof(wchar_t));if(!wide)return NULL;if(((unsigned char)raw[0]==0xFF&&(unsigned char)raw[1]==0xFE)||raw[1]==0){int offset=(unsigned char)raw[0]==0xFF?2:0;size_t bytes=n+1-offset;memcpy(wide,raw+offset,bytes);wide[32769]=0;}else if(!MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,raw,-1,wide,32770)&&!MultiByteToWideChar(CP_ACP,0,raw,-1,wide,32770)){free(wide);return NULL;}return wide;}
static int xml_value(const wchar_t *xml,const wchar_t *tag,wchar_t *out,int cap){wchar_t open[64],close[64];swprintf(open,64,L"<%ls>",tag);swprintf(close,64,L"</%ls>",tag);const wchar_t *begin=wcsstr(xml,open);if(!begin)return 0;begin+=wcslen(open);const wchar_t *end=wcsstr(begin,close);if(!end)return 0;int at=0;while(begin<end){wchar_t c=*begin++;if(c==L'&'){if(!wcsncmp(begin,L"amp;",4)){c=L'&';begin+=4;}else if(!wcsncmp(begin,L"lt;",3)){c=L'<';begin+=3;}else if(!wcsncmp(begin,L"gt;",3)){c=L'>';begin+=3;}else if(!wcsncmp(begin,L"quot;",5)){c=L'"';begin+=5;}else if(!wcsncmp(begin,L"apos;",5)){c=L'\'';begin+=5;}else return 0;}if(at+1>=cap)return 0;out[at++]=c;}out[at]=0;return 1;}
static int try_authorized_start(int requested_command){if(g_test_mode||g_authorized||process_elevated()||!g_settings.skip_uac)return 0;wchar_t sid[192],program_files[MAX_PATH],parent[MAX_PATH],directory[MAX_PATH],protected_exe[MAX_PATH],current[MAX_PATH];if(!current_sid(sid,192)||FAILED(SHGetFolderPathW(NULL,CSIDL_PROGRAM_FILES,NULL,SHGFP_TYPE_CURRENT,program_files)))return 0;path_join(parent,MAX_PATH,program_files,L"OrionMemoryAuthorized");path_join(directory,MAX_PATH,parent,sid);path_join(protected_exe,MAX_PATH,directory,L"OrionMemory.exe");GetModuleFileNameW(NULL,current,MAX_PATH);if(!real_path(parent,1)||!real_path(directory,1)||!real_path(protected_exe,0)||!same_product(current,protected_exe))return 0;wchar_t task[256],arguments[512];swprintf(task,256,L"OrionMemory.Elevated.%ls",sid);swprintf(arguments,512,L"/Query /TN \"%ls\" /XML",task);char *raw=NULL;if(!run_scheduler(arguments,&raw)){free(raw);return 0;}wchar_t *xml=scheduler_xml(raw);free(raw);if(!xml)return 0;wchar_t path[MAX_PATH],args[128],principal[192],level[64],enabled[16];int valid=xml_value(xml,L"Command",path,MAX_PATH)&&!_wcsicmp(path,protected_exe)&&xml_value(xml,L"Arguments",args,128)&&!wcscmp(args,L"--authorized-start")&&xml_value(xml,L"UserId",principal,192)&&!wcscmp(principal,sid)&&xml_value(xml,L"RunLevel",level,64)&&!wcscmp(level,L"HighestAvailable")&&(!xml_value(xml,L"Enabled",enabled,16)||!wcscmp(enabled,L"true"));free(xml);if(!valid)return 0;swprintf(arguments,512,L"/Run /TN \"%ls\"",task);if(!run_scheduler(arguments,NULL))return 0;if(requested_command!=CMD_SHOW){for(int i=0;i<100;++i){HWND target=FindWindowW(HOST_CLASS,NULL);if(target){PostMessageW(target,WM_REQUEST,(WPARAM)requested_command,0);break;}Sleep(20);}}return 1;}

static ACom a_com_initialize(void){ACom value;memset(&value,0,sizeof(value));value.status=E_FAIL;value.library=LoadLibraryW(L"ole32.dll");if(value.library){typedef HRESULT(WINAPI *Initialize)(void*,DWORD);Initialize initialize=(Initialize)GetProcAddress(value.library,"CoInitializeEx");value.uninitialize=(void(WINAPI*)(void))GetProcAddress(value.library,"CoUninitialize");if(initialize)value.status=initialize(NULL,2);}return value;}
static void a_com_close(ACom *value){if(SUCCEEDED(value->status)&&value->uninitialize)value->uninitialize();if(value->library)FreeLibrary(value->library);}

static void a_buffer(ABuffer *b,size_t capacity){memset(b,0,sizeof(*b));b->capacity=capacity;if(!capacity){b->failed=1;return;}b->text=(char*)malloc(capacity);if(b->text)b->text[0]=0;else b->failed=1;}
static void a_append(ABuffer *b,const char *text){if(b->failed)return;size_t n=strlen(text);if(n>=b->capacity-b->length){b->failed=1;return;}memcpy(b->text+b->length,text,n+1);b->length+=n;}
static void a_printf(ABuffer *b,const char *format,...){if(b->failed)return;va_list args;va_start(args,format);int n=vsnprintf(b->text+b->length,b->capacity-b->length,format,args);va_end(args);if(n<0||(size_t)n>=b->capacity-b->length)b->failed=1;else b->length+=(size_t)n;}
static void a_json_string(ABuffer *b,const char *text){a_append(b,"\"");for(const unsigned char *p=(const unsigned char*)(text?text:"");*p;++p){char escaped[8];if(*p=='"'||*p=='\\'){escaped[0]='\\';escaped[1]=(char)*p;escaped[2]=0;}else if(*p<32)snprintf(escaped,sizeof(escaped),"\\u%04x",*p);else{escaped[0]=(char)*p;escaped[1]=0;}a_append(b,escaped);}a_append(b,"\"");}
static void a_utf8(const wchar_t *wide,char *out,int cap){if(!WideCharToMultiByte(CP_UTF8,0,wide,-1,out,cap,NULL,NULL)&&cap)out[0]=0;}
static void a_wide(const char *text,wchar_t *out,int cap){if(!MultiByteToWideChar(CP_UTF8,0,text,-1,out,cap)&&cap)out[0]=0;}
static void a_add_message(AResult *r,int error,const char *text){int *count=error?&r->errors:&r->operations;int cap=error?512:256;if(*count>=A_MAX_MESSAGES)return;char *target=error?r->error[(*count)++]:r->operation[(*count)++];snprintf(target,(size_t)cap,"%s",text);}
static void a_label(const char *source,char *out,int cap){wchar_t translated[512];translate(source,translated,512);a_utf8(translated,out,cap);}
static void a_win_error(AResult *r,const char *label,DWORD error){wchar_t detail[300];char utf8[650],translated[300],text[900];if(!FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM|FORMAT_MESSAGE_IGNORE_INSERTS,NULL,error,0,detail,300,NULL))swprintf(detail,300,L"Windows 0x%08lX",error);for(size_t n=wcslen(detail);n&&iswspace(detail[n-1]);--n)detail[n-1]=0;a_utf8(detail,utf8,sizeof(utf8));a_label(label,translated,sizeof(translated));snprintf(text,sizeof(text),"%s: %s",translated,utf8);a_add_message(r,1,text);}
/* Parent-side launch errors use labels captured on the UI thread. A language
   switch can otherwise free g_language_json while the cleanup thread reads it. */
static void a_thread_win_error(AJob *job,const char *label,DWORD error){
    wchar_t detail[300];char utf8[650],text[900];
    if(!FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM|FORMAT_MESSAGE_IGNORE_INSERTS,NULL,error,0,detail,300,NULL))swprintf(detail,300,L"Windows 0x%08lX",error);
    for(size_t n=wcslen(detail);n&&iswspace(detail[n-1]);--n)detail[n-1]=0;
    a_utf8(detail,utf8,sizeof(utf8));
    snprintf(text,sizeof(text),"%s: %s",!strcmp(label,"Falha na limpeza")?job->cleanup_error:job->launch_error,utf8);
    a_add_message(&job->result,1,text);
}
static void a_timestamp(wchar_t *out,int cap){SYSTEMTIME t;GetLocalTime(&t);swprintf(out,cap,L"%04u-%02u-%02uT%02u:%02u:%02u.%03u",t.wYear,t.wMonth,t.wDay,t.wHour,t.wMinute,t.wSecond,t.wMilliseconds);}
static ULONGLONG a_available(void){MEMORYSTATUSEX memory;memset(&memory,0,sizeof(memory));memory.dwLength=sizeof(memory);return GlobalMemoryStatusEx(&memory)?memory.ullAvailPhys:0;}
static void a_init_result(AResult *r,const wchar_t *trigger){memset(r,0,sizeof(*r));a_timestamp(r->timestamp,48);copyw(r->trigger,64,trigger?trigger:L"Manual");r->before=r->after=a_available();}
static char *a_result_json(const AResult *r){ABuffer b;a_buffer(&b,65536);char timestamp[192],trigger[256];a_utf8(r->timestamp,timestamp,sizeof(timestamp));a_utf8(r->trigger,trigger,sizeof(trigger));a_append(&b,"{\"Timestamp\":");a_json_string(&b,timestamp);a_append(&b,",\"Trigger\":");a_json_string(&b,trigger);a_printf(&b,",\"BeforeAvailable\":%llu,\"AfterAvailable\":%llu,\"DurationMilliseconds\":%llu,\"Operations\":[",(unsigned long long)r->before,(unsigned long long)r->after,(unsigned long long)r->duration);for(int i=0;i<r->operations;++i){if(i)a_append(&b,",");a_json_string(&b,r->operation[i]);}a_append(&b,"],\"Errors\":[");for(int i=0;i<r->errors;++i){if(i)a_append(&b,",");a_json_string(&b,r->error[i]);}a_append(&b,"]}");if(b.failed){free(b.text);return NULL;}return b.text;}
static void a_read_array(Json *j,const char *key,AResult *r,int errors){int n=json_find(j,key);if(n<0||j->tokens[n].type!=J_ARRAY)return;for(int i=n+1;i<j->tokens[n].next;i=j->tokens[i].next){char text[512];if(json_text(j,i,text,sizeof(text)))a_add_message(r,errors,text);}}
static int a_parse_result(const char *text,AResult *r){Json j;if(!json_init(&j,text,strlen(text))){json_free(&j);return 0;}memset(r,0,sizeof(*r));r->before=(ULONGLONG)json_number(&j,"BeforeAvailable",0);r->after=(ULONGLONG)json_number(&j,"AfterAvailable",0);r->duration=(ULONGLONG)json_number(&j,"DurationMilliseconds",0);json_wide(&j,"Timestamp",r->timestamp,48);json_wide(&j,"Trigger",r->trigger,64);a_read_array(&j,"Operations",r,0);a_read_array(&j,"Errors",r,1);json_free(&j);return 1;}

static int a_write_atomic(const wchar_t *path,const char *document){wchar_t temporary[MAX_PATH],backup[MAX_PATH];swprintf(temporary,MAX_PATH,L"%ls.%lu.%ld.tmp",path,GetCurrentProcessId(),InterlockedIncrement(&a_file_sequence));swprintf(backup,MAX_PATH,L"%ls.bak",path);HANDLE file=CreateFileW(temporary,GENERIC_WRITE,0,NULL,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,NULL);if(file==INVALID_HANDLE_VALUE)return 0;DWORD bytes=(DWORD)strlen(document),written=0;int ok=WriteFile(file,document,bytes,&written,NULL)&&written==bytes&&FlushFileBuffers(file);DWORD error=GetLastError();CloseHandle(file);if(ok){if(GetFileAttributesW(path)!=INVALID_FILE_ATTRIBUTES)ok=ReplaceFileW(path,temporary,backup,REPLACEFILE_IGNORE_MERGE_ERRORS,NULL,NULL);else ok=MoveFileExW(temporary,path,MOVEFILE_WRITE_THROUGH);error=GetLastError();}if(!ok)DeleteFileW(temporary);SetLastError(error);return ok;}
static int a_parse_history(Json *j,const char *text){memset(j,0,sizeof(*j));j->text=text;j->length=strlen(text);j->capacity=128;j->tokens=(Token*)calloc((size_t)j->capacity,sizeof(Token));if(!j->tokens)return 0;if(j->length>=3&&(unsigned char)text[0]==0xEF&&(unsigned char)text[1]==0xBB&&(unsigned char)text[2]==0xBF)j->pos=3;int root=parse_value(j,0);whitespace(j);return root==0&&!j->error&&j->pos==j->length&&j->tokens[0].type==J_ARRAY;}
static char *a_load_history(const wchar_t *path,Json *j){char *doc=read_utf8(path);if(doc&&a_parse_history(j,doc))return doc;if(doc)json_free(j);free(doc);wchar_t backup[MAX_PATH];swprintf(backup,MAX_PATH,L"%ls.bak",path);doc=read_utf8(backup);if(doc&&a_parse_history(j,doc))return doc;if(doc)json_free(j);free(doc);doc=_strdup("[]");if(doc&&!a_parse_history(j,doc)){json_free(j);free(doc);doc=NULL;}return doc;}
static int a_history_append_at(const wchar_t *path,const AResult *result){Json j;char *old=a_load_history(path,&j),*entry=a_result_json(result);if(!old||!entry){free(old);free(entry);if(old)json_free(&j);return 0;}ABuffer b;a_buffer(&b,JSON_MAX);a_append(&b,"[\n");a_append(&b,entry);int count=1;for(int n=1;n<j.tokens[0].next&&count<A_MAX_ROWS;n=j.tokens[n].next){if(j.tokens[n].type!=J_OBJECT)continue;a_append(&b,",\n");size_t length=(size_t)(j.tokens[n].end-j.tokens[n].start);if(length>=b.capacity-b.length){b.failed=1;break;}memcpy(b.text+b.length,old+j.tokens[n].start,length);b.length+=length;b.text[b.length]=0;++count;}a_append(&b,"\n]\n");int ok=!b.failed&&a_write_atomic(path,b.text);free(old);free(entry);free(b.text);json_free(&j);return ok;}
static void a_history_path(wchar_t *path){path_join(path,MAX_PATH,g_data_dir,L"history.json");}
static int a_history_clear_at(const wchar_t *path){return a_write_atomic(path,"[]")&&a_write_atomic(path,"[]");}
static int a_record_object(Json *source,int token,Json *object){if(token<0||source->tokens[token].type!=J_OBJECT)return 0;Token t=source->tokens[token];char *copy=(char*)malloc((size_t)(t.end-t.start)+1);if(!copy)return 0;memcpy(copy,source->text+t.start,(size_t)(t.end-t.start));copy[t.end-t.start]=0;if(!json_init(object,copy,strlen(copy))){json_free(object);free(copy);return 0;}return 1;}
static void a_free_object(Json *object){const char *text=object->text;json_free(object);free((void*)text);}
static void a_csv_field(ABuffer *b,const char *value){const char *p=value?value:"";while(*p==' '||*p=='\t')++p;a_append(b,"\"");if(*p=='='||*p=='+'||*p=='-'||*p=='@')a_append(b,"'");for(p=value?value:"";*p;++p){char one[2]={*p,0};if(*p=='"')a_append(b,"\"");a_append(b,one);}a_append(b,"\"");}
static void a_array_join(Json *j,const char *key,char *out,size_t cap){ABuffer b;a_buffer(&b,cap);int n=json_find(j,key);if(n>=0&&j->tokens[n].type==J_ARRAY)for(int i=n+1;i<j->tokens[n].next;i=j->tokens[i].next){char text[512];if(json_text(j,i,text,sizeof(text))){if(b.length)a_append(&b," / ");a_append(&b,text);}}snprintf(out,cap,"%s",b.text?b.text:"");free(b.text);}
static int a_export_csv_at(const wchar_t *history_path,const wchar_t *destination){Json history;char *doc=a_load_history(history_path,&history);if(!doc)return 0;ABuffer b;a_buffer(&b,4u*JSON_MAX);a_append(&b,"\xEF\xBB\xBF" "Data;Origem;Regiões;MB disponíveis antes;MB disponíveis depois;Variação MB;Operações;Erros;Duração ms\r\n");int count=0;for(int n=1;n<history.tokens[0].next&&count<A_MAX_ROWS;n=history.tokens[n].next){Json row;if(!a_record_object(&history,n,&row))continue;char timestamp[192]="",trigger[256]="",operations[8192],errors[16384];json_text(&row,json_find(&row,"Timestamp"),timestamp,sizeof(timestamp));json_text(&row,json_find(&row,"Trigger"),trigger,sizeof(trigger));a_array_join(&row,"Operations",operations,sizeof(operations));a_array_join(&row,"Errors",errors,sizeof(errors));double before=json_number(&row,"BeforeAvailable",0),after=json_number(&row,"AfterAvailable",0);a_csv_field(&b,timestamp);a_append(&b,";");a_csv_field(&b,trigger);a_append(&b,";");a_csv_field(&b,operations);a_printf(&b,";%.1f;%.1f;%.1f;",before/1048576.0,after/1048576.0,(after-before)/1048576.0);a_csv_field(&b,operations);a_append(&b,";");a_csv_field(&b,errors);a_printf(&b,";%.0f\r\n",json_number(&row,"DurationMilliseconds",0));a_free_object(&row);++count;}int ok=0;if(!b.failed){HANDLE file=CreateFileW(destination,GENERIC_WRITE,0,NULL,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,NULL);if(file!=INVALID_HANDLE_VALUE){DWORD written;ok=WriteFile(file,b.text,(DWORD)b.length,&written,NULL)&&written==b.length&&FlushFileBuffers(file);CloseHandle(file);}}free(doc);json_free(&history);free(b.text);return ok;}

static int a_enable_privilege(const wchar_t *name){HANDLE token;if(!OpenProcessToken(GetCurrentProcess(),TOKEN_QUERY|TOKEN_ADJUST_PRIVILEGES,&token))return 0;TOKEN_PRIVILEGES privileges;memset(&privileges,0,sizeof(privileges));privileges.PrivilegeCount=1;int ok=LookupPrivilegeValueW(NULL,name,&privileges.Privileges[0].Luid);privileges.Privileges[0].Attributes=SE_PRIVILEGE_ENABLED;if(ok){SetLastError(ERROR_SUCCESS);ok=AdjustTokenPrivileges(token,FALSE,&privileges,0,NULL,NULL)&&GetLastError()!=ERROR_NOT_ALL_ASSIGNED;}DWORD error=GetLastError();CloseHandle(token);SetLastError(error);return ok;}
static int a_elevated(void){HANDLE token;TOKEN_ELEVATION value;DWORD length;if(!OpenProcessToken(GetCurrentProcess(),TOKEN_QUERY,&token))return 0;int ok=GetTokenInformation(token,TokenElevation,&value,sizeof(value),&length);CloseHandle(token);return ok&&value.TokenIsElevated;}
static void a_nt_operation(AResult *r,int information_class,void *data,ULONG length,const char *label,int profile_privilege){typedef LONG(NTAPI *NtSet)(int,void*,ULONG);NtSet set=(NtSet)GetProcAddress(GetModuleHandleW(L"ntdll.dll"),"NtSetSystemInformation");if(!set){a_win_error(r,label,ERROR_PROC_NOT_FOUND);return;}if(profile_privilege&&!a_enable_privilege(L"SeProfileSingleProcessPrivilege")){a_win_error(r,label,GetLastError());return;}LONG status=set(information_class,data,length);char translated[256];a_label(label,translated,sizeof(translated));if(status<0){char error[400];snprintf(error,sizeof(error),"%s: NTSTATUS 0x%08lX",translated,(unsigned long)status);a_add_message(r,1,error);}else a_add_message(r,0,translated);}
static int a_protected_process(const wchar_t *name){static const wchar_t *protected_names[]={L"System",L"Registry",L"Memory Compression",L"Secure System",L"csrss.exe",L"wininit.exe",L"winlogon.exe",L"services.exe",L"lsass.exe",L"smss.exe",L"dwm.exe",L"explorer.exe",L"MsMpEng.exe",L"sihost.exe",L"powershell.exe",L"pwsh.exe",L"WindowsTerminal.exe",L"OpenConsole.exe",L"cmd.exe",L"conhost.exe",L"StartMenuExperienceHost.exe",L"SearchHost.exe",L"ShellExperienceHost.exe",L"fontdrvhost.exe"};for(unsigned i=0;i<sizeof(protected_names)/sizeof(*protected_names);++i)if(!_wcsicmp(name,protected_names[i]))return 1;return 0;}
static void a_background_sets(AResult *r){typedef BOOL(WINAPI *Empty)(HANDLE);typedef BOOL(WINAPI *MemoryInfo)(HANDLE,PPROCESS_MEMORY_COUNTERS,DWORD);HMODULE kernel=GetModuleHandleW(L"kernel32.dll");Empty empty=(Empty)GetProcAddress(kernel,"K32EmptyWorkingSet");MemoryInfo memory_info=(MemoryInfo)GetProcAddress(kernel,"K32GetProcessMemoryInfo");if(!empty||!memory_info){a_win_error(r,"Conjuntos de trabalho em segundo plano",ERROR_PROC_NOT_FOUND);return;}HANDLE list=CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS,0);if(list==INVALID_HANDLE_VALUE){a_win_error(r,"Conjuntos de trabalho em segundo plano",GetLastError());return;}DWORD foreground=0,session=0;GetWindowThreadProcessId(GetForegroundWindow(),&foreground);ProcessIdToSessionId(GetCurrentProcessId(),&session);PROCESSENTRY32W item;memset(&item,0,sizeof(item));item.dwSize=sizeof(item);int trimmed=0;if(Process32FirstW(list,&item))do{DWORD other_session=0;if(item.th32ProcessID==GetCurrentProcessId()||item.th32ProcessID==foreground||a_protected_process(item.szExeFile)||!ProcessIdToSessionId(item.th32ProcessID,&other_session)||!other_session||other_session!=session)continue;HANDLE process=OpenProcess(PROCESS_SET_QUOTA|PROCESS_QUERY_INFORMATION,FALSE,item.th32ProcessID);if(!process)continue;PROCESS_MEMORY_COUNTERS memory;memset(&memory,0,sizeof(memory));memory.cb=sizeof(memory);if(memory_info(process,&memory,sizeof(memory))&&memory.WorkingSetSize>=128u*1024u*1024u&&empty(process))++trimmed;CloseHandle(process);if(trimmed>=64)break;}while(Process32NextW(list,&item));CloseHandle(list);if(trimmed){char label[256],text[300];a_label("Conjuntos de trabalho em segundo plano",label,sizeof(label));snprintf(text,sizeof(text),"%s: %d",label,trimmed);a_add_message(r,0,text);}else{char label[256];a_label("Conjuntos de trabalho: nenhum processo elegível pôde ser reduzido.",label,sizeof(label));a_add_message(r,1,label);}}
static void a_flush_volumes(AResult *r){DWORD drives=GetLogicalDrives();int eligible=0;for(int i=0;i<26;++i)if(drives&(1u<<i)){wchar_t root[4]={(wchar_t)(L'A'+i),L':',L'\\',0};if(GetDriveTypeW(root)!=DRIVE_FIXED)continue;wchar_t path[8];swprintf(path,8,L"\\\\.\\%c:",L'A'+i);HANDLE volume=CreateFileW(path,GENERIC_WRITE,FILE_SHARE_READ|FILE_SHARE_WRITE,NULL,OPEN_EXISTING,0,NULL);++eligible;if(volume==INVALID_HANDLE_VALUE){a_win_error(r,"Cache de arquivos modificados",GetLastError());continue;}int ok=FlushFileBuffers(volume);DWORD error=GetLastError();CloseHandle(volume);if(ok){char label[256],operation[300];a_label("Cache de arquivos modificados",label,sizeof(label));snprintf(operation,sizeof(operation),"%s %c:",label,'A'+i);a_add_message(r,0,operation);}else a_win_error(r,"Cache de arquivos modificados",error);}if(!eligible)a_win_error(r,"Cache de arquivos modificados",ERROR_NOT_READY);}
static void a_real_operation(int index,AResult *r,void *unused){(void)unused;if(g_test_mode){a_add_message(r,1,"Operação bloqueada no modo de teste.");return;}const char *label=region_labels[index];switch(index){case 0:{int command=2;a_nt_operation(r,80,&command,sizeof(command),label,1);break;}case 1:{if(!a_enable_privilege(L"SeIncreaseQuotaPrivilege")||!SetSystemFileCacheSize((SIZE_T)-1,(SIZE_T)-1,0))a_win_error(r,label,GetLastError());else{char text[256];a_label(label,text,sizeof(text));a_add_message(r,0,text);}break;}case 2:{int command=3;a_nt_operation(r,80,&command,sizeof(command),label,1);break;}case 3:{int command=4;a_nt_operation(r,80,&command,sizeof(command),label,1);break;}case 4:{int command=5;a_nt_operation(r,80,&command,sizeof(command),label,1);break;}case 5:a_flush_volumes(r);break;case 6:a_nt_operation(r,155,NULL,0,label,0);break;case 7:{struct { HANDLE handle;ULONG_PTR pages;ULONG flags; } combine;memset(&combine,0,sizeof(combine));a_nt_operation(r,130,&combine,sizeof(combine),label,1);break;}case 8:a_background_sets(r);break;}}

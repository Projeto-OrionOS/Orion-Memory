static int a_job_ready(const AJob *job){
    if(job->thread&&WaitForSingleObject(job->thread,0)!=WAIT_OBJECT_0)return 0;
    /* Thread completion synchronizes the worker-handle handoff. No blocking
       wait runs on the UI thread, and no second cleanup can overlap a timed-out
       child that is still inside an operating-system call. */
    if(job->worker&&WaitForSingleObject(job->worker,0)!=WAIT_OBJECT_0)return 0;
    return 1;
}

static void a_duration_text(ULONGLONG milliseconds,wchar_t *out,int cap){
    wchar_t decimal[8]=L",";
    GetLocaleInfoEx(g_settings.language,LOCALE_SDECIMAL,decimal,8);
    swprintf(out,cap,L"%llu%ls%02llu s",(unsigned long long)(milliseconds/1000),decimal,(unsigned long long)((milliseconds%1000)/10));
}
static void a_summary(const AResult *result,wchar_t *out,int cap){
    wchar_t state[128],duration[48];
    translate(result->operations?(result->errors?"Parcial":"Concluído"):"Não concluído",state,128);
    a_duration_text(result->duration,duration,48);
    LONGLONG delta=(LONGLONG)result->after-(LONGLONG)result->before;
    if(result->operations)swprintf(out,cap,L"%ls • %+.0f MB • %ls",state,(double)delta/1048576.0,duration);
    else swprintf(out,cap,L"%ls • %ls",state,duration);
}
/* Balloon text is deliberately separate from the compact history row. Windows
   exposes only 255 characters here, so every state fits without losing errors. */
static void native_format_cleanup_notification(const AResult *result,wchar_t *out,int cap){
    if(cap<=0)return;
    wchar_t state[128],measure[128],elapsed[48],time_label[64],history[96];
    translate(result->operations?(result->errors?"Limpeza parcial":"Limpeza concluída"):"Limpeza não concluída",state,128);
    translate("Tempo",time_label,64);
    translate("Consulte o histórico para ver os detalhes.",history,96);
    a_duration_text(result->duration,elapsed,48);
    LONGLONG delta=(LONGLONG)result->after-(LONGLONG)result->before;
    if(!result->operations){
        swprintf(out,cap,L"%ls\n%ls: %ls\n%ls",state,time_label,elapsed,history);
    }else{
        translate(delta>0?"Memória liberada estimada":delta<0?"Redução da memória disponível":"Sem aumento da memória disponível",measure,128);
        if(delta)swprintf(out,cap,L"%ls\n%ls: %.0f MB\n%ls: %ls%ls%ls",state,measure,(double)(delta<0?-delta:delta)/1048576.0,time_label,elapsed,result->errors?L"\n":L"",result->errors?history:L"");
        else swprintf(out,cap,L"%ls\n%ls\n%ls: %ls%ls%ls",state,measure,time_label,elapsed,result->errors?L"\n":L"",result->errors?history:L"");
    }
    out[cap-1]=0;

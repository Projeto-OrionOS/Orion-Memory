static HANDLE a_create_pipe(wchar_t *name,int cap){typedef BOOLEAN(WINAPI *Random)(PVOID,ULONG);Random random=(Random)GetProcAddress(GetModuleHandleW(L"advapi32.dll"),"SystemFunction036");BYTE bytes[16];if(!random||!random(bytes,sizeof(bytes)))return INVALID_HANDLE_VALUE;copyw(name,(size_t)cap,L"OrionMemory-Native-");for(int i=0;i<16;++i)swprintf(name+19+i*2,(size_t)cap-19-i*2,L"%02x",bytes[i]);HANDLE token=NULL;DWORD length=0;TOKEN_USER *user=NULL;LPWSTR sid=NULL;PSECURITY_DESCRIPTOR descriptor=NULL;HANDLE pipe=INVALID_HANDLE_VALUE;if(!OpenProcessToken(GetCurrentProcess(),TOKEN_QUERY,&token))goto done;GetTokenInformation(token,TokenUser,NULL,0,&length);user=(TOKEN_USER*)malloc(length);if(!user||!GetTokenInformation(token,TokenUser,user,length,&length)||!ConvertSidToStringSidW(user->User.Sid,&sid))goto done;wchar_t security[512];swprintf(security,512,L"D:P(A;;GA;;;%ls)(A;;GA;;;BA)",sid);if(!ConvertStringSecurityDescriptorToSecurityDescriptorW(security,SDDL_REVISION_1,&descriptor,NULL))goto done;SECURITY_ATTRIBUTES attributes={sizeof(attributes),descriptor,FALSE};wchar_t path[96];swprintf(path,96,L"\\\\.\\pipe\\%ls",name);pipe=CreateNamedPipeW(path,PIPE_ACCESS_DUPLEX|FILE_FLAG_OVERLAPPED|FILE_FLAG_FIRST_PIPE_INSTANCE,PIPE_TYPE_BYTE|PIPE_READMODE_BYTE|PIPE_WAIT|PIPE_REJECT_REMOTE_CLIENTS,1,65536,65536,0,&attributes);done:if(descriptor)LocalFree(descriptor);if(sid)LocalFree(sid);free(user);if(token)CloseHandle(token);return pipe;}
static DWORD WINAPI a_cleanup_thread(void *context){
    AJob *job=(AJob*)context;
    if(g_test_mode){a_add_message(&job->result,1,"Operação bloqueada no modo de teste.");return 0;}
    /* An automatic job inherits this already elevated token via CreateProcess.
       It never calls ShellExecute/runas or opens a consent dialog. The child
       retains the fixed pipe protocol and validates its own elevation again. */
    if(job->automatic&&!a_elevated()){
        a_add_message(&job->result,1,"A limpeza automática requer o aplicativo já autorizado como administrador.");
        return 0;
    }
    ACom com;memset(&com,0,sizeof(com));com.status=E_FAIL;
    if(!job->automatic)com=a_com_initialize();
    wchar_t name[64],executable[MAX_PATH],arguments[MAX_PATH+160];
    HANDLE process=NULL,pipe=a_create_pipe(name,64);
    if(pipe==INVALID_HANDLE_VALUE){a_thread_win_error(job,"Não foi possível iniciar a limpeza.",GetLastError());a_com_close(&com);return 0;}
    OVERLAPPED connection;memset(&connection,0,sizeof(connection));
    connection.hEvent=CreateEventW(NULL,TRUE,FALSE,NULL);
    if(!connection.hEvent){a_thread_win_error(job,"Não foi possível iniciar a limpeza.",GetLastError());goto done;}
    int connected=ConnectNamedPipe(pipe,&connection);
    DWORD connect_error=GetLastError();
    if(!GetModuleFileNameW(NULL,executable,MAX_PATH)){a_thread_win_error(job,"Não foi possível iniciar a limpeza.",GetLastError());goto done;}
    if(job->automatic){
        STARTUPINFOW startup;PROCESS_INFORMATION child;
        memset(&startup,0,sizeof(startup));memset(&child,0,sizeof(child));startup.cb=sizeof(startup);
        startup.dwFlags=STARTF_USESHOWWINDOW;startup.wShowWindow=SW_HIDE;
        swprintf(arguments,MAX_PATH+160,L"\"%ls\" --native-clean-worker \"%ls\"",executable,name);
        if(!CreateProcessW(executable,arguments,NULL,NULL,FALSE,CREATE_NO_WINDOW,NULL,NULL,&startup,&child)){
            a_thread_win_error(job,"Não foi possível iniciar a limpeza.",GetLastError());goto done;
        }
        process=child.hProcess;CloseHandle(child.hThread);
    }else{
        SHELLEXECUTEINFOW launch;memset(&launch,0,sizeof(launch));launch.cbSize=sizeof(launch);
        launch.fMask=SEE_MASK_NOCLOSEPROCESS|SEE_MASK_FLAG_NO_UI|SEE_MASK_NOASYNC;
        launch.hwnd=job->owner;launch.lpVerb=L"runas";launch.lpFile=executable;
        swprintf(arguments,MAX_PATH+160,L"--native-clean-worker \"%ls\"",name);
        launch.lpParameters=arguments;launch.nShow=SW_HIDE;
        if(!ShellExecuteExW(&launch)){a_thread_win_error(job,"Não foi possível iniciar a limpeza.",GetLastError());goto done;}
        process=launch.hProcess;
    }
    if(!process){a_add_message(&job->result,1,"A identidade do auxiliar de limpeza não pôde ser confirmada.");goto done;}
    if(!connected){
        if(connect_error==ERROR_PIPE_CONNECTED)connected=1;
        else if(connect_error==ERROR_IO_PENDING){
            HANDLE waits[2]={connection.hEvent,process};
            DWORD wait=WaitForMultipleObjects(2,waits,FALSE,A_TIMEOUT);
            if(wait==WAIT_OBJECT_0){DWORD transferred;connected=GetOverlappedResult(pipe,&connection,&transferred,FALSE);}
            else{a_add_message(&job->result,1,wait==WAIT_TIMEOUT?"Tempo limite da limpeza excedido.":"O auxiliar de limpeza encerrou antes de conectar.");goto done;}
        }
    }
    if(!connected){a_thread_win_error(job,"Não foi possível iniciar a limpeza.",GetLastError());goto done;}
    ULONG client_pid=0;
    if(!GetNamedPipeClientProcessId(pipe,&client_pid)||client_pid!=GetProcessId(process)){
        a_add_message(&job->result,1,"A identidade do auxiliar de limpeza não pôde ser confirmada.");goto done;
    }
    if(!a_pipe_transfer(pipe,&job->request,sizeof(job->request),1)){a_thread_win_error(job,"Falha na limpeza",GetLastError());goto done;}
    DWORD length=0;
    if(!a_pipe_transfer(pipe,&length,sizeof(length),0)||!length||length>65535){a_add_message(&job->result,1,"Resposta de limpeza inválida.");goto done;}
    char *reply=(char*)calloc((size_t)length+1,1);
    if(!reply||!a_pipe_transfer(pipe,reply,length,0)||!a_parse_result(reply,&job->result))a_add_message(&job->result,1,"Resposta de limpeza inválida.");
    free(reply);

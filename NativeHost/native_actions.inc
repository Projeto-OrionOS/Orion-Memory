    /* A transfer deadline does not prove that a privileged operation stopped.
       Keep the owned process handle until the UI can observe its termination. */
    job->worker=process;
    CancelIoEx(pipe,NULL);
    if(connection.hEvent){WaitForSingleObject(connection.hEvent,100);CloseHandle(connection.hEvent);}
    CloseHandle(pipe);a_com_close(&com);return 0;
}

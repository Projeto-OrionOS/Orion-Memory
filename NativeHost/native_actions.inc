static int native_worker_liveness_self_test(void){
    int failures=0;AJob *job=(AJob*)calloc(1,sizeof(*job));
    if(!job)return check(0,"native worker liveness fixture allocation");
    job->thread=CreateEventW(NULL,TRUE,FALSE,NULL);job->worker=CreateEventW(NULL,TRUE,FALSE,NULL);
    if(!job->thread||!job->worker){
        if(job->thread)CloseHandle(job->thread);if(job->worker)CloseHandle(job->worker);free(job);
        return check(0,"native worker liveness event fixtures");
    }
    failures+=check(!a_job_ready(job),"cleanup cannot complete while its communication thread is still active");
    SetEvent(job->thread);
    AJob *previous=a_job;int was_busy=g_busy;a_job=job;g_busy=1;
    native_actions_tick();
    int deferred=a_job==job&&g_busy;
    failures+=check(deferred,"a finished cleanup thread retains its job and busy state while a timed-out worker remains active");
    if(deferred){
        SetEvent(job->worker);
        failures+=check(a_job_ready(job),"cleanup completion becomes eligible only after the retained worker signals termination");
        CloseHandle(job->thread);CloseHandle(job->worker);free(job);
    }
    a_job=previous;g_busy=was_busy;return failures;
}

static void a_execute_plan(DWORD mask,AResult *r,ARunner run,void *context){static const int order[]={4,3,8,0,1,2,5,6,7};for(unsigned i=0;i<sizeof(order)/sizeof(*order);++i){int index=order[i];if(!(mask&(1u<<index)))continue;if(index==4&&(mask&(1u<<3)))continue;if(index==8&&(mask&1u))continue;run(index,r,context);}if(!r->operations&&!r->errors){char text[256];a_label("Nenhuma área de limpeza selecionada. Selecione as regiões nas configurações.",text,sizeof(text));a_add_message(r,1,text);}}

static int a_pipe_transfer(HANDLE pipe,void *buffer,DWORD length,int writing){BYTE *at=(BYTE*)buffer;while(length){OVERLAPPED pending;memset(&pending,0,sizeof(pending));pending.hEvent=CreateEventW(NULL,TRUE,FALSE,NULL);if(!pending.hEvent)return 0;DWORD transferred=0;int ok=writing?WriteFile(pipe,at,length,&transferred,&pending):ReadFile(pipe,at,length,&transferred,&pending);if(!ok&&GetLastError()==ERROR_IO_PENDING){DWORD wait=WaitForSingleObject(pending.hEvent,A_TIMEOUT);if(wait!=WAIT_OBJECT_0){CancelIoEx(pipe,&pending);DWORD cancelled;GetOverlappedResult(pipe,&pending,&cancelled,TRUE);CloseHandle(pending.hEvent);SetLastError(ERROR_TIMEOUT);return 0;}ok=GetOverlappedResult(pipe,&pending,&transferred,FALSE);}DWORD error=GetLastError();CloseHandle(pending.hEvent);if(!ok||!transferred){SetLastError(error);return 0;}at+=transferred;length-=transferred;}return 1;}
